t t=\"w\" w=\"\u03bc\u03b5\u03c4\u1f70\" i=\"1\" o=\"21\">\u03bc\u03b5\u03c4\u1f70</t> <t t=\"w\" w=\"\u0393\u03bb\u03b1\u03cd\u03ba\u03c9\u03bd\u03bf\u03c2\" i=\"1\" o=\"25\">\u0393\u03bb\u03b1\u03cd\u03ba\u03c9\u03bd\u03bf\u03c2</t> <t t=\"w\" w=\"\u03c4\u03bf\u1fe6\" i=\"1\" o=\"34\">\u03c4\u03bf\u1fe6</t> <t t=\"w\" w=\"\u1f08\u03c1\u03af\u03c3\u03c4\u03c9\u03bd\u03bf\u03c2\" i=\"1\" o=\"37\">\u1f08\u03c1\u03af\u03c3\u03c4\u03c9\u03bd\u03bf\u03c2</t> <t t=\"w\" w=\"\u03c0\u03c1\u03bf\u03c3\u03b5\u03c5\u03be\u03cc\u03bc\u03b5\u03bd\u03cc\u03c2\" i=\"1\" o=\"46\">\u03c0\u03c1\u03bf\u03c3\u03b5\u03c5\u03be\u03cc\u03bc\u03b5\u03bd\u03cc\u03c2</t> <t t=\"w\" w=\"\u03c4\u03b5\" i=\"1\" o=\"59\">\u03c4\u03b5</t> <t t=\"w\" w=\"\u03c4\u1fc7\" i=\"1\" o=\"61\">\u03c4\u1fc7</t> <t t=\"w\" w=\"\u03b8\u03b5\u1ff7\" i=\"1\" o=\"63\">\u03b8\u03b5\u1ff7</t> <t t=\"w\" w=\"\u03ba\u03b1\u1f76\" i=\"1\" o=\"66\">\u03ba\u03b1\u1f76</t> <t t=\"w\" w=\"\u1f05\u03bc\u03b1\" i=\"1\" o=\"69\">\u1f05\u03bc\u03b1</t> <t t=\"w\" w=\"\u03c4\u1f74\u03bd\" i=\"1\" o=\"72\">\u03c4\u1f74\u03bd</t> <t t=\"w\" w=\"\u1f11\u03bf\u03c1\u03c4\u1f74\u03bd\" i=\"1\" o=\"75\">\u1f11\u03bf\u03c1\u03c4\u1f74\u03bd</t> <t t=\"w\" w=\"\u03b2\u03bf\u03c5\u03bb\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2\" i=\"1\" o=\"81\">\u03b2\u03bf\u03c5\u03bb\u03cc\u03bc\u03b5\u03bd\u03bf\u03c2</t> <t t=\"w\" w=\"\u03b8\u03b5\u03ac\u03c3\u03b1\u03c3\u03b8\u03b1\u03b9\" i=\"1\" o=\"91\">\u03b8\u03b5\u03ac\u03c3\u03b1\u03c3\u03b8\u03b1\u03b9</t> <t t=\"w\" w=\"\u03c4\u03af\u03bd\u03b1\" i=\"1\" o=\"100\">\u03c4\u03af\u03bd\u03b1</t> <t t=\"w\" w=\"\u03c4\u03c1\u03cc\u03c0\u03bf\u03bd\" i=\"1\" o=\"104\">\u03c4\u03c1\u03cc\u03c0\u03bf\u03bd</t> <t t=\"w\" w=\"\u03c0\u03bf\u03b9\u03ae\u03c3\u03bf\u03c5\u03c3\u03b9\u03bd\" i=\"1\" o=\"110\">\u03c0\u03bf\u03b9\u03ae\u03c3\u03bf\u03c5\u03c3\u03b9\u03bd</t> <t t=\"w\" w=\"\u1f05\u03c4\u03b5\" i=\"1\" o=\"120\">\u1f05\u03c4\u03b5</t> <t t=\"w\" w=\"\u03bd\u1fe6\u03bd\" i=\"1\" o=\"123\"
# ai4ra-mcp behind Caddy. The process listens on localhost:8000; Caddy owns TLS
# and the public name. Two forms, pick one.
#
# The process answers CORS itself (any origin), so nothing here touches
# Access-Control headers. Every server is a path under the process
# (/<name>/mcp and /<name>/skills/, the index at /), so one reverse_proxy
# covers all of them, including servers added later.

# Form 1: the process is the whole site. The index is https://mcp.example.uidaho.edu/
# and each server is https://mcp.example.uidaho.edu/<name>/mcp.
mcp.example.uidaho.edu {
    encode gzip

    # grants-gov-s2s-mock (see docker-compose.yml): OpenERA's S2S test surface, under /s2s-mock/.
    # Plain HTTP behind Caddy; the mock does not verify client certificates here, only when run
    # locally with its own CA. Its control API (/s2s-mock/_control/*) has no auth: the remote_ip
    # matcher keeps it to campus. Drop this block when the mock is retired.
    @s2s_control path /s2s-mock/_control/*
    handle @s2s_control {
        @offcampus not remote_ip 129.101.0.0/16 private_ranges
        respond @offcampus 403
        uri strip_prefix /s2s-mock
        reverse_proxy 127.0.0.1:8081
    }
    handle_path /s2s-mock/* {
        reverse_proxy 127.0.0.1:8081 {
            transport http {
                read_timeout 300s      # an armed timeout is the point
            }
        }
    }

    reverse_proxy 127.0.0.1:8000 {
        flush_interval -1              # stream responses as they arrive
        transport http {
            read_timeout 300s          # a long fetch_document or lakehouse read
        }
    }

    log {
        output file /var/log/caddy/ai4ra-mcp.log
        format json
    }
}

# The private speed test (deploy/speedtest, docker-compose.yml), in either form. Caddy does not know the secret: it
# forwards /speedtest/* and the process answers 404 to a wrong one. Paste the block into the site, above the other
# handle blocks. log_skip is Caddy 2.8 or later (skip_log before that).
#
# example.uidaho.edu {
#     @speedtest path /speedtest/*
#     log_skip @speedtest                  # the path holds the secret
#     request_header @speedtest -Accept-Encoding   # site level, since encode runs before handle: never compressed
#     handle @speedtest {
#         reverse_proxy 127.0.0.1:8082 {
#             flush_interval -1            # responses pass through as they arrive
#             request_buffers 0            # a buffered upload would make its measured speed meaningless
#             response_buffers 0
#             transport http {
#                 dial_timeout 5s
#                 read_timeout 120s
#                 write_timeout 120s
#             }
#         }
#     }
#     # ... the rest of the site
# }
#
# log_skip covers the access log only. Caddy's runtime logs carry the request URI too: reverse_proxy's "aborting with
# incomplete response" (WARN, on every client that hangs up mid-download) and http.log.error (ERROR, on a 502 when the
# container is down). So the global options at the very top of the Caddyfile split those two loggers out and delete
# the URI from them, every site's lines included; access logs keep theirs. Merge with any global log settings already
# there.
#
# {
#     log default {
#         exclude http.handlers.reverse_proxy http.log.error
#     }
#     log no_uri {
#         include http.handlers.reverse_proxy http.log.error
#         format filter {
#             request>uri delete
#         }
#     }
# }

# Form 2: the process under /mcp/ on a host that serves other things (the demo
# deployment). handle_path strips the prefix, so the index is https://host/mcp/
# and each server https://host/mcp/<name>/mcp; the index's relative paths
# resolve under the prefix on their own.
#
# example.uidaho.edu {
#     handle_path /s2s-mock/* {           # the S2S mock, same as in Form 1
#         reverse_proxy 127.0.0.1:8081
#     }
#     handle_path /mcp/* {
#         reverse_proxy 127.0.0.1:8000 {
#             flush_interval -1
#             transport http {
#                 read_timeout 300s
#             }
#         }
#     }
#     # ... the rest of the site
# }
